<h1 class="mb-4 text-2xl font-bold">温度逸脱</h1>
<%= form_with url: excursions_path, method: :get, class: "mb-4 flex flex-wrap gap-3", data: { controller: "search" } do |f| %>
  <%= f.select :status, options_for_select([["進行中", "open"], ["終了", "closed"]], params[:status]), { include_blank: "全状態" }, class: "#{input_class} max-w-xs", data: { action: "change->search#submit" } %>
  <%= f.select :zone_id, options_for_select(@zones.map { |z| [z.to_s, z.id] }, params[:zone_id]), { include_blank: "全ゾーン" }, class: "#{input_class} max-w-xs", data: { action: "change->search#submit" } %>
<% end %>
<div class="<%= card_class %> overflow-x-auto">
  <table class="<%= table_class %>">
    <thead><tr><th class="<%= th_class %>">#</th><th class="<%= th_class %>">ゾーン</th><th class="<%= th_class %>">開始</th><th class="<%= th_class %>">終了</th><th class="<%= th_class %>">ピーク℃</th><th class="<%= th_class %>">検知</th><th class="<%= th_class %>">状態</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% @excursions.each do |e| %>
        <tr>
          <td class="<%= td_class %>"><%= link_to e.id, e, class: "text-sky-700 underline" %></td>
          <td class="<%= td_class %>"><%= e.zone %></td>
          <td class="<%= td_class %>"><%= fmt_time(e.started_at) %></td>
          <td class="<%= td_class %>"><%= fmt_time(e.ended_at) %></td>
          <td class="<%= td_class %>"><%= fmt_qty(e.peak_value) %></td>
          <td class="<%= td_class %>"><%= badge(enum_label(:detected_via, e.detected_via), e.detected_at_import? ? :amber : :slate) %></td>
          <td class="<%= td_class %>"><%= badge(e.open? ? "進行中" : "終了", e.open? ? :red : :slate) %></td>
        </tr>
      <% end %>
      <% if @excursions.empty? %><tr><td colspan="7" class="px-3 py-6 text-center text-slate-500">逸脱はありません</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= link_to "逸脱履歴CSV", excursion_history_report_path(format: :csv), class: btn_class(:secondary) %></div>
<%= render "shared/pager", page: @page, has_next: @has_next %>
