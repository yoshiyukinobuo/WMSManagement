<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold">取込 #<%= @batch.id %> <%= badge(enum_label(:status, @batch.status), { "completed" => :green, "failed" => :red, "rolled_back" => :slate }[@batch.status] || :sky) %></h1>
  <div class="flex gap-3">
    <%= link_to "一覧へ", imports_path, class: btn_class(:secondary) %>
    <% if can?(:import_data) && @batch.stock_opening? %>
      <% if @batch.status == "validated" %>
        <%= button_to "取り込みを実行", commit_import_path(@batch), method: :post, class: btn_class, form: { data: { turbo_confirm: "#{@batch.payload.size}件のロットを登録します。よろしいですか?" } } %>
      <% elsif @batch.status == "completed" %>
        <%= button_to "取り込みを取り消す", rollback_import_path(@batch), method: :post, class: btn_class(:danger), form: { data: { turbo_confirm: "この取込で登録したロットと移動を削除します。よろしいですか?" } } %>
      <% end %>
    <% end %>
  </div>
</div>
<div class="<%= card_class %> mb-6 grid gap-2 text-sm sm:grid-cols-4">
  <div><span class="text-slate-500">種別:</span> <%= enum_label(:kind, @batch.kind) %></div>
  <div><span class="text-slate-500">ファイル:</span> <%= @batch.filename %></div>
  <div><span class="text-slate-500">総行数:</span> <%= @batch.total_rows %></div>
  <div><span class="text-slate-500">エラー:</span> <%= @batch.error_rows %></div>
  <div><span class="text-slate-500">登録:</span> <%= @batch.success_rows %></div>
  <div><span class="text-slate-500">重複スキップ:</span> <%= @batch.skipped_rows %></div>
  <div><span class="text-slate-500">実行者:</span> <%= @batch.uploaded_by %></div>
</div>

<% if @batch.row_errors.any? %>
  <section class="<%= card_class %> mb-6 overflow-x-auto">
    <h2 class="mb-2 font-semibold text-red-700">エラー(差異レポート・先頭200件)</h2>
    <table class="<%= table_class %>">
      <thead><tr><th class="<%= th_class %>">行</th><th class="<%= th_class %>">内容</th></tr></thead>
      <tbody class="divide-y divide-slate-100"><% @batch.row_errors.each do |e| %><tr><td class="<%= td_class %>"><%= e["row"] %></td><td class="<%= td_class %>"><%= e["message"] %></td></tr><% end %></tbody>
    </table>
  </section>
<% end %>

<% if @batch.stock_opening? && @batch.payload.any? %>
  <section class="<%= card_class %> overflow-x-auto">
    <h2 class="mb-2 font-semibold">取込内容(プレビュー・先頭50件)</h2>
    <table class="<%= table_class %>">
      <thead><tr><th class="<%= th_class %>">行</th><th class="<%= th_class %>">ロット番号</th><th class="<%= th_class %>">ロケーション</th><th class="<%= th_class %>">数量</th><th class="<%= th_class %>">入荷日</th><th class="<%= th_class %>">期限</th><th class="<%= th_class %>">温度帯</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% @batch.payload.first(50).each do |r| %>
          <tr><td class="<%= td_class %>"><%= r["line"] %></td><td class="<%= td_class %>"><%= r["lot_number"] %></td><td class="<%= td_class %>"><%= Location.find_by(id: r["location_id"]) %></td><td class="<%= td_class %>"><%= r["quantity"] %></td><td class="<%= td_class %>"><%= r["received_on"] %></td><td class="<%= td_class %>"><%= r["expires_on"] %></td><td class="<%= td_class %>"><%= enum_label(:required_temperature_type, r["required_temperature_type"]) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
