<h1 class="mb-4 text-2xl font-bold">移動履歴</h1>
<%= form_with url: movements_path, method: :get, class: "mb-4 flex flex-wrap gap-3", data: { controller: "search" } do |f| %>
  <%= f.search_field :q, value: params[:q], placeholder: "ロット番号・ロットID", class: "#{input_class} max-w-xs", data: { action: "input->search#queue" } %>
  <%= f.select :movement_type, options_for_select(enum_options(:movement_type, StockMovement::TYPES), params[:movement_type]), { include_blank: "全種別" }, class: "#{input_class} max-w-xs", data: { action: "change->search#submit" } %>
  <%= f.datetime_local_field :from, value: params[:from], class: "#{input_class} max-w-xs", data: { action: "change->search#submit" } %>
<% end %>
<div class="<%= card_class %> overflow-x-auto">
  <table class="<%= table_class %>">
    <thead><tr><th class="<%= th_class %>">日時</th><th class="<%= th_class %>">種別</th><th class="<%= th_class %>">ロット</th><th class="<%= th_class %>">移動元</th><th class="<%= th_class %>">移動先</th><th class="<%= th_class %>">数量</th><th class="<%= th_class %>">担当</th><th class="<%= th_class %>">備考</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% @movements.each do |m| %>
        <tr>
          <td class="<%= td_class %>"><%= fmt_time(m.performed_at) %></td>
          <td class="<%= td_class %>"><%= enum_label(:movement_type, m.movement_type) %></td>
          <td class="<%= td_class %>"><%= link_to "#{m.lot.internal_id} #{m.lot.lot_number}", m.lot, class: "text-sky-700 underline" %></td>
          <td class="<%= td_class %>"><%= m.from_location %></td>
          <td class="<%= td_class %>"><%= m.to_location %></td>
          <td class="<%= td_class %>"><%= fmt_qty(m.quantity) %></td>
          <td class="<%= td_class %>"><%= m.performed_by %></td>
          <td class="<%= td_class %>"><%= m.note %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-3"><%= link_to "CSV出力", movements_report_path(format: :csv), class: btn_class(:secondary) %></div>
<%= render "shared/pager", page: @page, has_next: @has_next %>
