<% lines = ReceiptLine.where(receipt_id: receipt.id).includes(:lot, :item).order(:id) %>
<% items = Item.where(customer_id: receipt.customer_id).order(:code) %>
<% locations = Location.accessible_by(Current.user).active.includes(zone: :site).where(zones: { site_id: receipt.site_id }).order(:zone_id, :code) %>
<div id="line_panel" class="space-y-6">
  <% if message %><p class="rounded-md bg-green-100 px-4 py-3 text-green-800"><%= message %></p><% end %>
  <% if error %><p class="rounded-md bg-red-100 px-4 py-3 text-red-800"><%= error %></p><% end %>

  <section class="<%= card_class %> overflow-x-auto">
    <h2 class="mb-2 font-semibold">登録済みロット</h2>
    <table class="<%= table_class %>">
      <thead><tr>
        <th class="<%= th_class %>">ロットID</th><th class="<%= th_class %>">ロット番号</th><th class="<%= th_class %>">伝票 / マニフェスト</th>
        <th class="<%= th_class %>">予定</th><th class="<%= th_class %>">実数</th><th class="<%= th_class %>">温度帯</th><th class="<%= th_class %>">フラグ</th><th class="<%= th_class %>">格納</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% lines.each do |l| %>
          <% unplaced = l.lot ? l.lot.unplaced_quantity : 0 %>
          <tr>
            <td class="<%= td_class %>"><%= link_to l.lot.internal_id, l.lot, class: "text-sky-700 underline" if l.lot %></td>
            <td class="<%= td_class %>"><%= l.lot_number %></td>
            <td class="<%= td_class %>"><%= [l.slip_lot_number, l.manifest_lot_number].compact_blank.join(" / ") %></td>
            <td class="<%= td_class %>"><%= fmt_qty(l.expected_quantity) %></td>
            <td class="<%= td_class %>"><%= fmt_qty(l.received_quantity) %> <%= l.unit %></td>
            <td class="<%= td_class %>"><%= enum_label(:required_temperature_type, l.required_temperature_type) %></td>
            <td class="<%= td_class %>"><%= badge("3情報不一致", :amber) if l.source_mismatch %> <%= badge("数量差異", :amber) if l.quantity_discrepancy %></td>
            <td class="<%= td_class %>">
              <% if unplaced.positive? && can?(:operate_stock) %>
                <%= form_with url: putaway_receipt_receipt_line_path(receipt, l), method: :patch, class: "flex gap-2" do |f| %>
                  <%= f.select :location_id, options_for_select(locations.map { |loc| ["#{loc.zone.name}/#{loc.code}", loc.id] }), { include_blank: "未格納 #{fmt_qty(unplaced)}" }, class: input_class %>
                  <%= f.submit "格納", class: btn_class(:secondary) %>
                <% end %>
              <% else %>済<% end %>
            </td>
          </tr>
        <% end %>
        <% if lines.empty? %><tr><td colspan="8" class="px-3 py-6 text-center text-slate-500">まだロットがありません</td></tr><% end %>
      </tbody>
    </table>
  </section>

  <% if can?(:operate_stock) && !receipt.completed? %>
    <section class="<%= card_class %>">
      <h2 class="mb-3 font-semibold">ロットを登録</h2>
      <%= form_with model: [receipt, line], id: "new_receipt_line", class: "grid gap-4 sm:grid-cols-2 lg:grid-cols-3", data: { controller: "location-filter" } do |f| %>
        <div><%= f.label :lot_number, "ロット番号(現品)", class: label_class %><%= f.text_field :lot_number, class: input_class, autofocus: true %></div>
        <div><%= f.label :slip_lot_number, "ロット番号(伝票)", class: label_class %><%= f.text_field :slip_lot_number, class: input_class %></div>
        <div><%= f.label :manifest_lot_number, "ロット番号(マニフェスト)", class: label_class %><%= f.text_field :manifest_lot_number, class: input_class %></div>
        <div>
          <%= f.label :item_id, "品目(任意)", class: label_class %>
          <select name="receipt_line[item_id]" id="receipt_line_item_id" class="<%= input_class %>" data-action="change->location-filter#itemChanged">
            <option value="">(未指定)</option>
            <% items.each do |i| %><option value="<%= i.id %>" data-required-type="<%= i.required_temperature_type %>" data-unit="<%= i.unit %>" <%= "selected" if line.item_id == i.id %>><%= i %></option><% end %>
          </select>
        </div>
        <div><%= f.label :expected_quantity, "予定数量", class: label_class %><%= f.number_field :expected_quantity, step: "any", min: 0, class: input_class %></div>
        <div><%= f.label :received_quantity, "実数量", class: label_class %><%= f.number_field :received_quantity, step: "any", min: 0, class: input_class %></div>
        <div><%= f.label :unit, "単位", class: label_class %><%= f.text_field :unit, value: line.unit.presence || "個", class: input_class, data: { location_filter_target: "unit" } %></div>
        <div>
          <%= f.label :required_temperature_type, "要求温度帯", class: label_class %>
          <%= f.select :required_temperature_type, options_for_select(enum_options(:required_temperature_type, Zone::TYPES), line.required_temperature_type), { include_blank: "(指定なし)" },
                class: input_class, data: { location_filter_target: "type", action: "change->location-filter#filter" } %>
        </div>
        <div><%= f.label :expires_on, "賞味期限", class: label_class %><%= f.date_field :expires_on, class: input_class %></div>
        <div>
          <label for="receipt_line_location_id" class="<%= label_class %>">格納ロケーション(任意)</label>
          <select name="receipt_line[location_id]" id="receipt_line_location_id" class="<%= input_class %>" data-location-filter-target="location">
            <option value="">(後で格納)</option>
            <% locations.each do |loc| %><option value="<%= loc.id %>" data-zone-type="<%= loc.zone.zone_type %>"><%= loc.zone.name %> / <%= loc.code %>(<%= enum_label(:zone_type, loc.zone.zone_type) %>)</option><% end %>
          </select>
          <p class="mt-1 text-xs text-slate-500">要求温度帯に合うロケーションのみ表示されます。</p>
        </div>
        <div class="sm:col-span-2"><%= f.label :note, "備考", class: label_class %><%= f.text_field :note, class: input_class %></div>
        <% if can?(:override_zone_mismatch) %>
          <label class="flex min-h-[44px] items-center gap-2"><%= check_box_tag :force, "1", false, class: "h-5 w-5" %> 温度帯不一致でも格納(責任者のみ)</label>
        <% end %>
        <div class="sm:col-span-2 lg:col-span-3"><%= f.submit "登録", class: btn_class %></div>
      <% end %>
    </section>
  <% end %>
</div>
