<div class="mx-auto mt-16 max-w-sm <%= card_class %>">
  <h1 class="mb-4 text-xl font-bold">ヨコウン倉庫管理 ログイン</h1>
  <%= form_with url: session_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "メールアドレス", class: label_class %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: input_class %>
    </div>
    <div>
      <%= form.label :password, "パスワード", class: label_class %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: input_class %>
    </div>
    <%= form.submit "ログイン", class: "#{btn_class} w-full" %>
  <% end %>
  <p class="mt-4 text-sm"><%= link_to "パスワードを忘れた場合", new_password_path, class: "text-sky-700 underline" %></p>
</div>
