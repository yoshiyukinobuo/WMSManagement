<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ヨコウン倉庫管理" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if authenticated? %>
      <header class="bg-slate-900 text-white print:hidden">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2">
          <%= link_to "ヨコウン倉庫", root_path, class: "text-lg font-bold mr-4" %>
          <nav class="flex flex-wrap gap-x-1 text-sm">
            <% nav_items.each do |label, path| %>
              <%= link_to label, path, class: "rounded px-3 py-2 hover:bg-slate-700 #{'bg-slate-700' if current_page?(path)}" %>
            <% end %>
          </nav>
          <div class="ml-auto flex items-center gap-3 text-sm">
