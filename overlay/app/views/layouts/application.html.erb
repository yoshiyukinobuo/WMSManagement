<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ヨコウン倉庫管理" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if authenticated? %>
      <header class="bg-slate-900 text-white print:hidden">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2">
          <%= link_to "ヨコウン倉庫", root_path, class: "text-lg font-bold mr-4" %>
          <nav class="flex flex-wrap gap-x-1 text-sm">
            <% nav_items.each do |label, path| %>
              <%= link_to label, path, class: "rounded px-3 py-2 hover:bg-slate-700 #{'bg-slate-700' if current_page?(path)}" %>
            <% end %>
          </nav>
          <div class="ml-auto flex items-center gap-3 text-sm">
            <span><%= Current.user %>(<%= enum_label(:role, Current.user.role) %>)</span>
            <%= button_to "ログアウト", session_path, method: :delete, class: "rounded border border-slate-500 px-3 py-2 hover:bg-slate-700" %>
          </div>
        </div>
        <div class="bg-slate-800 text-xs">
          <div class="mx-auto flex max-w-7xl flex-wrap gap-x-1 px-4 py-1">
            <span class="px-2 py-1 text-slate-400">マスタ</span>
            <% master_links.each do |label, path| %><%= link_to label, path, class: "rounded px-2 py-1 hover:bg-slate-700" %><% end %>
            <span class="px-2 py-1 text-slate-400 ml-3">管理</span>
            <% admin_links.each do |label, path| %><%= link_to label, path, class: "rounded px-2 py-1 hover:bg-slate-700" %><% end %>
          </div>
        </div>
      </header>
    <% end %>
    <main class="mx-auto max-w-7xl px-4 py-6">
      <div data-controller="flash">
        <% if notice %><p class="mb-4 rounded-md bg-green-100 px-4 py-3 text-green-800" data-flash-target="message"><%= notice %></p><% end %>
        <% if alert %><p class="mb-4 rounded-md bg-red-100 px-4 py-3 text-red-800"><%= alert %></p><% end %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
