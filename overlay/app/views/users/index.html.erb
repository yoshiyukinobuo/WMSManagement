<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">ユーザー</h1>
  <%= link_to "新規ユーザー", new_user_path, class: btn_class %>
</div>
<div class="<%= card_class %> overflow-x-auto">
  <table class="<%= table_class %>">
    <thead><tr><th class="<%= th_class %>">氏名</th><th class="<%= th_class %>">メール</th><th class="<%= th_class %>">ロール</th><th class="<%= th_class %>">拠点</th><th class="<%= th_class %>">有効</th><th class="<%= th_class %>"></th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% @users.each do |u| %>
        <tr>
          <td class="<%= td_class %>"><%= u.name %></td>
          <td class="<%= td_class %>"><%= u.email_address %></td>
          <td class="<%= td_class %>"><%= enum_label(:role, u.role) %></td>
          <td class="<%= td_class %>"><%= u.system_admin? ? "全拠点" : u.sites.map(&:code).join(", ") %></td>
          <td class="<%= td_class %>"><%= u.active? ? "○" : "−" %></td>
          <td class="<%= td_class %>"><%= link_to "編集", edit_user_path(u), class: "text-sky-700 underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
