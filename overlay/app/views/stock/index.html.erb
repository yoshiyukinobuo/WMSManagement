<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">在庫</h1>
  <%= link_to "CSV出力", stock_report_path(format: :csv), class: btn_class(:secondary) %>
</div>
<%= form_with url: stock_path, method: :get, class: "mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-6", data: { controller: "search" } do |f| %>
  <%= f.search_field :q, value: params[:q], placeholder: "ロット・荷主", class: input_class, data: { action: "input->search#queue" } %>
  <%= f.select :site_id, options_for_select(accessible_sites.map { |s| [s.to_s, s.id] }, params[:site_id]), { include_blank: "全拠点" }, class: input_class, data: { action: "change->search#submit" } %>
  <%= f.select :zone_id, options_for_select(@zones.map { |z| [z.to_s, z.id] }, params[:zone_id]), { include_blank: "全ゾーン" }, class: input_class, data: { action: "change->search#submit" } %>
  <%= f.search_field :location, value: params[:location], placeholder: "ロケーション(前方一致)", class: input_class, data: { action: "input->search#queue" } %>
  <%= f.date_field :from, value: params[:from], class: input_class, title: "入荷日(自)", data: { action: "change->search#submit" } %>
  <%= f.date_field :to, value: params[:to], class: input_class, title: "入荷日(至)", data: { action: "change->search#submit" } %>
<% end %>

<% if @unplaced.any? %>
  <div class="mb-4 rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800">
    未格納のロット:
    <% @unplaced.each do |lot| %><%= link_to "#{lot.internal_id}(#{fmt_qty(lot.unplaced_quantity)})", lot, class: "underline mr-2" %><% end %>
  </div>
<% end %>

<div class="<%= card_class %> overflow-x-auto">
  <table class="<%= table_class %>">
    <thead><tr><th class="<%= th_class %>">ロケーション</th><th class="<%= th_class %>">ロットID</th><th class="<%= th_class %>">ロット番号</th><th class="<%= th_class %>">荷主</th><th class="<%= th_class %>">数量</th><th class="<%= th_class %>">入荷日</th><th class="<%= th_class %>">期限</th><th class="<%= th_class %>">状態</th><th class="<%= th_class %>"></th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% @levels.each do |lv| %>
        <tr>
          <td class="<%= td_class %>"><%= lv.location %></td>
          <td class="<%= td_class %>"><%= link_to lv.lot.internal_id, lv.lot, class: "text-sky-700 underline" %></td>
          <td class="<%= td_class %>"><%= lv.lot.lot_number %></td>
          <td class="<%= td_class %>"><%= lv.lot.customer.name %></td>
          <td class="<%= td_class %> font-semibold"><%= fmt_qty(lv.quantity) %></td>
          <td class="<%= td_class %>"><%= fmt_date(lv.lot.received_on) %></td>
          <td class="<%= td_class %>"><%= fmt_date(lv.lot.expires_on) %></td>
          <td class="<%= td_class %>"><%= lot_status_badge(lv.lot) %></td>
          <td class="<%= td_class %>"><% if can?(:operate_stock) %><%= link_to "移動", new_movement_path(lot_id: lv.lot_id, from_location_id: lv.location_id), class: "text-sky-700 underline" %><% end %></td>
        </tr>
      <% end %>
      <% if @levels.empty? %><tr><td colspan="9" class="px-3 py-6 text-center text-slate-500">在庫がありません</td></tr><% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pager", page: @page, has_next: @has_next %>
