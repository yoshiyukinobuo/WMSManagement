<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold"><%= title %></h1>
  <% if can?(ability) %><%= link_to "新規登録", new_polymorphic_path(model), class: btn_class %><% end %>
</div>
<div class="<%= card_class %> overflow-x-auto">
  <table class="<%= table_class %>">
    <thead><tr>
      <% columns.each do |c| %><th class="<%= th_class %>"><%= model.human_attribute_name(c) %></th><% end %>
      <th class="<%= th_class %>"></th>
    </tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% @records.each do |record| %>
        <tr>
          <% columns.each do |c| %><td class="<%= td_class %>"><%= display_value(record, c) %></td><% end %>
          <td class="<%= td_class %> whitespace-nowrap text-right">
            <% if can?(ability) %>
              <%= link_to "編集", edit_polymorphic_path(record), class: "text-sky-700 underline mr-3" %>
              <%= button_to "削除", polymorphic_path(record), method: :delete, class: "text-red-600 underline", form: { class: "inline", data: { turbo_confirm: "削除しますか?" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @records.empty? %><tr><td colspan="<%= columns.size + 1 %>" class="px-3 py-6 text-center text-slate-500">データがありません</td></tr><% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pager", page: @page, has_next: @has_next %>
